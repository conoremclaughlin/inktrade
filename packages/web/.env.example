SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Schwab app credentials from developer.schwab.com.
# These identify the *app*, not the user — each individual still authorizes
# through the Schwab OAuth flow at /settings. Optional: without them the app
# falls back to Yahoo Finance for market data.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Must match the callback URL registered on your Schwab app exactly.
SCHWAB_REDIRECT_URI=https://127.0.0.1:6001/api/auth/schwab/callback
