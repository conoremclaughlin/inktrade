# Absolute URL of the Inktrade web API, reachable from the device.
#
# `localhost` resolves to the phone itself on a physical device, so use the LAN
# address printed by the Next dev server ("Network: http://192.168.x.x:6001").
# The simulator can use localhost.
EXPO_PUBLIC_API_URL=http://192.168.86.60:6001
